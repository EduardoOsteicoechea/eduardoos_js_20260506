[Unit]
Description=Eduardoos S3 Media API
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/s3
EnvironmentFile=-/home/ec2-user/s3/.env
Environment=PORT=8130
Environment=BIND_HOST=127.0.0.1
ExecStart=/home/ec2-user/s3/s3api
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
