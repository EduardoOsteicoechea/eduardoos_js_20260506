[Unit]
Description=Eduardoos Posts Database API (DynamoDB)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/database
EnvironmentFile=-/home/ec2-user/database/.env
Environment=PORT=8120
Environment=BIND_HOST=127.0.0.1
Environment=DATA_STORE=dynamodb
Environment=AWS_REGION=us-east-1
Environment=DYNAMODB_CATALOG_TABLE=eduardoos_catalog
Environment=DYNAMODB_POSTS_TABLE=eduardoos_posts
Environment=DYNAMODB_USERS_TABLE=eduardoos_users
Environment=DYNAMODB_REFRESH_TOKENS_TABLE=eduardoos_refresh_tokens
ExecStart=/home/ec2-user/database/postsdb
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
