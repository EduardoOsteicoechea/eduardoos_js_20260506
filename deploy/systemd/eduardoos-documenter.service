[Unit]
Description=Eduardoos Documenter API
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/documenter
Environment=NODE_ENV=production
Environment=PORT=8090
ExecStart=/usr/bin/node dist/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
