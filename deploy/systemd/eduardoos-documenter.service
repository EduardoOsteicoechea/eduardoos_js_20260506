[Unit]
Description=Eduardoos Documenter API
After=network.target eduardoos-s3.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/documenter
Environment=NODE_ENV=production
Environment=PORT=8090
Environment=S3_URL=http://127.0.0.1:8130
EnvironmentFile=-/home/ec2-user/documenter/.env
ExecStart=/usr/bin/node dist/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
