[Unit]
Description=Eduardoos Telemetry API
After=network.target eduardoos-backend.service eduardoos-documenter.service eduardoos-chatbot.service eduardoos-database.service eduardoos-s3.service

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/telemetry
Environment=NODE_ENV=production
Environment=PORT=8100
Environment=LOG_MODE=systemd
Environment=LOG_LINES=80
Environment=BACKEND_UNIT=eduardoos-backend
Environment=DOCUMENTER_UNIT=eduardoos-documenter
Environment=HOST_PROC=/proc
Environment=DISK_PATH=/
Environment=BACKEND_DIST_PATH=/home/ec2-user/backend/dist/server.js
Environment=DOCUMENTER_DIST_PATH=/home/ec2-user/documenter/dist/server.js
Environment=BACKEND_HEALTH_URL=http://127.0.0.1:8080/api/series/catalog
Environment=DOCUMENTER_HEALTH_URL=http://127.0.0.1:8090/health
Environment=CHATBOT_HEALTH_URL=http://127.0.0.1:8110/health
Environment=CHATBOT_UNIT=eduardoos-chatbot
Environment=CHATBOT_PORT=8110
Environment=POSTS_DB_HEALTH_URL=http://127.0.0.1:8120/health
Environment=POSTS_DB_UNIT=eduardoos-database
Environment=POSTS_DB_PORT=8120
Environment=S3_HEALTH_URL=http://127.0.0.1:8130/health
Environment=S3_UNIT=eduardoos-s3
Environment=S3_PORT=8130
Environment=LEGACY_API_UNIT=eduardoos-api
ExecStart=/home/ec2-user/telemetry/telemetry
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
