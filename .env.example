# Posts database target for local Docker / dev.
# production (default): frontend reads and saves via https://eduardoos.com API (deploy DB).
# local: start local postsdb and point the stack at it — see docker-compose.local-db.yml
POSTS_DB_TARGET=production

# Override production API URL (optional).
# PRODUCTION_API_BASE=https://eduardoos.com

# S3 media (local Docker only — production credentials live on EC2 s3/.env)
# AWS_REGION=us-east-1
# S3_BUCKET=eduardoos20260607
# S3_ROOT_PREFIX=media
# S3_PUBLIC_BASE_URL=https://eduardoos20260607.s3.us-east-1.amazonaws.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
