PORT=8120
BIND_HOST=127.0.0.1
POSTS_DB_INTERNAL_TOKEN=change-me-internal-posts-db-token

# Persistence backend: dynamodb (default) or sqlite
DATA_STORE=dynamodb

# DynamoDB (production + local dev against real AWS tables)
AWS_REGION=us-east-1
DYNAMODB_CATALOG_TABLE=eduardoos_catalog
DYNAMODB_POSTS_TABLE=eduardoos_posts
DYNAMODB_USERS_TABLE=eduardoos_users
DYNAMODB_REFRESH_TOKENS_TABLE=eduardoos_refresh_tokens

# Optional: DynamoDB Local (DATA_STORE=dynamodb only)
# DYNAMODB_ENDPOINT=http://127.0.0.1:8000

# SQLite fallback (DATA_STORE=sqlite only)
# DB_PATH=posts.db
