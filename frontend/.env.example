# Server-side Astro build: discover + static paths (defaults to https://eduardoos.com).
PUBLIC_API_BASE=https://eduardoos.com

# Vite dev proxy only (/api → backend). Defaults to production when unset.
# Local isolated DB stack: docker compose -f docker-compose.yml -f docker-compose.local-db.yml up
#   then set DEV_API_PROXY=http://127.0.0.1:8080 and PUBLIC_API_BASE=http://127.0.0.1:8080
