---
interface Crumb {
  href: string;
  label: string;
}

interface Props {
  crumbs: Crumb[];
  currentLabel: string;
}

const { crumbs, currentLabel } = Astro.props;
---

<nav class="mb-8 text-sm" aria-label="Ruta de navegación">
  <ol class="flex flex-wrap items-center gap-1">
    {
      crumbs.map((crumb) => (
        <li class="flex items-center gap-1">
          <a
            href={crumb.href}
            class="font-medium underline opacity-80 hover:opacity-100"
          >
            {crumb.label}
          </a>
          <span class="theme-muted" aria-hidden="true">
            /
          </span>
        </li>
      ))
    }
    <li class="font-medium" aria-current="page">
      {currentLabel}
    </li>
  </ol>
</nav>
