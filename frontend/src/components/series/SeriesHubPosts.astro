---
import type { SeriesHubPostLink } from '../../lib/articles/types';

interface Props {
  posts: SeriesHubPostLink[];
}

const { posts } = Astro.props;
---

<ul class="series-card-list">
  {
    posts.map((post) => (
      <li>
        {post.href ? (
          <a href={post.href} class="series-card theme-border">
            <span class="series-card__title">
              {post.articleTitle ?? post.contribution}
            </span>
            {post.abstract ? (
              <p class="series-card__description theme-muted">{post.abstract}</p>
            ) : null}
            <span class="series-card__meta theme-muted">{post.contribution}</span>
          </a>
        ) : (
          <div class="series-card series-card--disabled theme-border">
            <span class="series-card__title">{post.contribution}</span>
            {post.abstract ? (
              <p class="series-card__description theme-muted">{post.abstract}</p>
            ) : null}
            <span class="series-card__meta theme-muted">Próximamente</span>
          </div>
        )}
      </li>
    ))
  }
</ul>
