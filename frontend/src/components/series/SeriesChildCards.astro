---
import type { SeriesChildLink } from '../../lib/articles/types';

interface Props {
  items: SeriesChildLink[];
}

const { items: childLinks } = Astro.props;
---

<ul class="series-card-list">
  {
    childLinks.map((child) => (
      <li>
        <a href={`/series/${child.slug}`} class="series-card theme-border">
          <span class="series-card__title">{child.label}</span>
          {child.description ? (
            <p class="series-card__description theme-muted">{child.description}</p>
          ) : null}
          <span class="series-card__slug theme-muted">/series/{child.slug}</span>
        </a>
      </li>
    ))
  }
</ul>
