---
import { discoverSeriesSlugs } from "../../lib/articles/discover";

export async function getStaticPaths() {
  const slugs = await discoverSeriesSlugs();
  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const slugParam = Astro.params.slug;
const slug =
  typeof slugParam === "string"
    ? slugParam
    : Array.isArray(slugParam)
      ? slugParam.join("/")
      : "";

return Astro.redirect(slug ? `/series/${slug}` : "/series", 301);
---
