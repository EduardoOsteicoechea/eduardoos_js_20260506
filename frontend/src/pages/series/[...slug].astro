---

import Layout from "../../layouts/Layout.astro";

import SeriesBreadcrumbs from "../../components/series/SeriesBreadcrumbs.jsx";
import SeriesBackLink from "../../components/series/SeriesBackLink.jsx";
import SeriesPostsHeading from "../../components/series/SeriesPostsHeading.jsx";
import SeriesEmptyMessage from "../../components/series/SeriesEmptyMessage.jsx";

import SeriesChildCards from "../../components/series/SeriesChildCards.astro";

import SeriesHubPosts from "../../components/series/SeriesHubPosts.astro";

import {

  loadDiscoverSnapshot,

  formatSegmentLabel,

  getHubPostLinks,

  getSeriesBreadcrumbs,

  getSeriesChildren,

} from "../../lib/articles/discover";

import type { ArticleData, SeriesHubData } from "../../lib/articles/types";

import ArticleViewer from "../../components/ArticleGenerator/ArticleViewer.jsx";



interface ArticleProps {

  routeKind: "article";

  slug: string;

  article: ArticleData;

  sermonPath?: string;

}



interface HubProps {

  routeKind: "hub";

  slug: string;

  hub: SeriesHubData;

  hubPosts: ReturnType<typeof getHubPostLinks>;

  pageTitle: string;

  breadcrumbs: ReturnType<typeof getSeriesBreadcrumbs>;

}



interface IndexProps {

  routeKind: "index";

  slug: string;

  pageTitle: string;

  breadcrumbs: ReturnType<typeof getSeriesBreadcrumbs>;

  children: Awaited<ReturnType<typeof getSeriesChildren>>;

}



type PageProps = ArticleProps | HubProps | IndexProps;

export async function getStaticPaths() {

  const { articles, hubs, slugs } = await loadDiscoverSnapshot();

  const hubBySlug = new Map(hubs.map((hub) => [hub.slug, hub]));

  const articleBySlug = new Map(articles.map((article) => [article.slug, article]));



  return Promise.all(

    slugs.map(async (slug) => {

      const article = articleBySlug.get(slug);

      if (article) {

        return {

          params: { slug },

          props: {

            routeKind: "article",

            slug,

            article: article.data,

            sermonPath: article.sermonPath,

          } satisfies ArticleProps,

        };

      }



      const hub = hubBySlug.get(slug);

      if (hub) {

        const pageTitle = hub.data.section

          ? String(hub.data.section)

          : formatSegmentLabel(slug.split("/").pop() ?? slug);



        return {

          params: { slug },

          props: {

            routeKind: "hub",

            slug,

            hub: hub.data,

            hubPosts: getHubPostLinks(slug, hub.data, articles),

            pageTitle,

            breadcrumbs: getSeriesBreadcrumbs(slug),

          } satisfies HubProps,

        };

      }



      const pageTitle = formatSegmentLabel(slug.split("/").pop() ?? slug);



      return {

        params: { slug },

        props: {

          routeKind: "index",

          slug,

          pageTitle,

          breadcrumbs: getSeriesBreadcrumbs(slug),

          children: await getSeriesChildren(slug, articles, hubs),

        } satisfies IndexProps,

      };

    }),

  );

}



const slugParam = Astro.params.slug as string | string[] | undefined;

const slug = Array.isArray(slugParam) ? slugParam.join("/") : (slugParam ?? "");

const props = Astro.props as PageProps;

---



{props.routeKind === "article" ? (

  <Layout
    title={`${props.article.title} | Eduardo Osteicoechea`}
    activityBarMode="article"
  >

    <main class="mx-auto max-w-3xl px-5 pb-[calc(var(--activity-bar-height)+1.25rem)] pt-10">

      <SeriesBackLink client:load />



      <ArticleViewer

        initialArticle={props.article}

        slug={slug}

        jsonPath={`/data/series/${slug}/data.json`}

        sermonPath={props.sermonPath}

        client:load

      />

    </main>

  </Layout>

) : props.routeKind === "hub" ? (

  <Layout title={`${props.pageTitle} | Eduardo Osteicoechea`}>

    <main class="mx-auto max-w-4xl px-5 py-10">

      <SeriesBreadcrumbs crumbs={props.breadcrumbs} currentLabel={props.pageTitle} client:load />



      <header class="mb-10">

        <p class="theme-muted text-sm uppercase tracking-wide">

          {props.hub.series ? `Serie ${props.hub.series}` : "Series"}

        </p>

        <h1 class="mt-2 text-3xl font-bold">{props.pageTitle}</h1>

        {props.hub.description ? (

          <p class="theme-muted mt-4 text-lg leading-relaxed">{props.hub.description}</p>

        ) : null}

        {props.hub.purpose ? (

          <p class="mt-4 leading-relaxed">{props.hub.purpose}</p>

        ) : null}

      </header>



      {

        props.hub.biblical_texts?.length ? (

          <section class="theme-border mb-10 rounded-lg border px-5 py-4">

            <h2 class="mb-3 text-sm font-semibold uppercase tracking-wide opacity-70">

              Texto bíblico

            </h2>

            <ul class="space-y-3">

              {props.hub.biblical_texts.map((item) => (

                <li>

                  {item.text ? <p class="leading-relaxed">{item.text}</p> : null}

                  {item.reference ? (

                    <p class="theme-muted mt-1 text-sm font-medium">{item.reference}</p>

                  ) : null}

                </li>

              ))}

            </ul>

          </section>

        ) : null

      }



      <section>

        <SeriesPostsHeading client:load />

        <SeriesHubPosts posts={props.hubPosts} />

      </section>

    </main>

  </Layout>

) : (

  <Layout title={`${props.pageTitle} | Eduardo Osteicoechea`}>

    <main class="mx-auto max-w-4xl px-5 py-10">

      <SeriesBreadcrumbs crumbs={props.breadcrumbs} currentLabel={props.pageTitle} client:load />



      <header class="mb-10">

        <h1 class="text-3xl font-bold">{props.pageTitle}</h1>

      </header>



      {props.children.length > 0 ? (

        <SeriesChildCards items={props.children} />

      ) : (

        <SeriesEmptyMessage client:load />

      )}

    </main>

  </Layout>

)}


