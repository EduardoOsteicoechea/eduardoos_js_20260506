---

import Layout from "../../layouts/Layout.astro";

import SeriesBreadcrumbs from "../../components/series/SeriesBreadcrumbs.jsx";
import SeriesBackLink from "../../components/series/SeriesBackLink.jsx";
import SeriesPostsHeading from "../../components/series/SeriesPostsHeading.jsx";
import SeriesEmptyMessage from "../../components/series/SeriesEmptyMessage.jsx";

import SeriesChildCards from "../../components/series/SeriesChildCards.astro";

import SeriesHubPostsLive from "../../components/series/SeriesHubPostsLive.jsx";

import { loadDiscoverSnapshot } from "../../lib/articles/discover";
import {
  resolveSeriesRoute,
  type SeriesRouteProps,
} from "../../lib/articles/seriesRoute";

import ArticleViewer from "../../components/ArticleGenerator/ArticleViewer.jsx";

type PageProps = SeriesRouteProps;

export const prerender = import.meta.env.PROD;

export async function getStaticPaths() {
  const { slugs } = await loadDiscoverSnapshot();

  return Promise.all(
    slugs.map(async (slug) => ({
      params: { slug },
      props: (await resolveSeriesRoute(slug)) as PageProps,
    })),
  );
}

const slugParam = Astro.params.slug as string | string[] | undefined;
const slug = Array.isArray(slugParam) ? slugParam.join("/") : (slugParam ?? "");

const props = import.meta.env.PROD
  ? (Astro.props as PageProps)
  : ((await resolveSeriesRoute(slug)) as PageProps);

---



{props.routeKind === "article" ? (

  <Layout
    title={`${props.article.title} | Eduardo Osteicoechea`}
    activityBarMode="article"
  >

    <main class="series-page series-page--article">

      <SeriesBackLink client:load />



      <ArticleViewer

        initialArticle={props.article}

        slug={slug}

        articleApiPath={props.articleApiPath}

        sermonPath={props.sermonPath}

        client:load

      />

    </main>

  </Layout>

) : props.routeKind === "hub" ? (

  <Layout title={`${props.pageTitle} | Eduardo Osteicoechea`}>

    <main class="series-page series-page--wide">

      <SeriesBreadcrumbs crumbs={props.breadcrumbs} currentLabel={props.pageTitle} client:load />

      <header class="series-page__header">

        <p class="series-page__kicker theme-muted">

          {props.hub.series ? `Serie ${props.hub.series}` : "Series"}

        </p>

        <h1 class="series-page__title">{props.pageTitle}</h1>

        {props.hub.description ? (

          <p class="series-page__description theme-muted">{props.hub.description}</p>

        ) : null}

        {props.hub.purpose ? (

          <p class="series-page__purpose">{props.hub.purpose}</p>

        ) : null}

      </header>

      {

        props.hub.biblical_texts?.length ? (

          <section class="series-biblical theme-border">

            <h2 class="series-biblical__title">

              Texto bíblico

            </h2>

            <ul class="series-biblical__list">

              {props.hub.biblical_texts.map((item) => (

                <li>

                  {item.text ? <p class="series-biblical__text">{item.text}</p> : null}

                  {item.reference ? (

                    <p class="series-biblical__reference theme-muted">{item.reference}</p>

                  ) : null}

                </li>

              ))}

            </ul>

          </section>

        ) : null

      }



      <section>

        <SeriesPostsHeading client:load />

        <SeriesHubPostsLive
          client:load
          hubSlug={slug}
          hub={props.hub}
          initialPosts={props.hubPosts}
        />

      </section>

    </main>

  </Layout>

) : (

  <Layout title={`${props.pageTitle} | Eduardo Osteicoechea`}>

    <main class="series-page series-page--wide">

      <SeriesBreadcrumbs crumbs={props.breadcrumbs} currentLabel={props.pageTitle} client:load />

      <header class="series-page__header">

        <h1 class="series-page__title series-page__title--solo">{props.pageTitle}</h1>

      </header>



      {props.children.length > 0 ? (

        <SeriesChildCards items={props.children} />

      ) : (

        <SeriesEmptyMessage client:load />

      )}

    </main>

  </Layout>

)}


