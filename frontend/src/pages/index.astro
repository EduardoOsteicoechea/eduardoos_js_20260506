---
import Layout from "../layouts/Layout.astro";
import HomeCtaButtons from "../components/HomeCta/HomeCtaButtons.jsx";
import HomeSkillsGrid from "../components/HomeSkills/HomeSkillsGrid.jsx";
---

<Layout>
  <main
    class="home-main min-h-screen px-4 py-5 pb-[calc(var(--activity-bar-height)+1.25rem)] sm:px-5 sm:py-6"
  >
    <h1
      class="text-2xl font-bold leading-tight sm:text-3xl lg:text-4xl"
      data-i18n="homeTitle"
    >
      BIM Software Development and Consulting
    </h1>
    <p class="mt-4 text-base leading-relaxed sm:text-lg" data-i18n="homeIntro">
      I'm an AI enthusiast Licensed Architect, BIM Modeler and Full Stack BIM
      Software Developer with a multidisciplinary background spanning Design,
      Architecture, Art, Technology, Software Engineering, AI integrations and
      Cloud-Based Solutions.
    </p>

    <HomeCtaButtons client:load />

    <HomeSkillsGrid />

    <p class="mt-8 text-base leading-relaxed sm:text-lg" data-i18n="homeOutro">
      I feel comfortable working in interdisciplinary, intercultural,
      inter-generational and inclusive remote and on-site teams.
    </p>
  </main>
</Layout>
