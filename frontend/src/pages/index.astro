---
import Layout from "../layouts/Layout.astro";
import HomeCtaButtons from "../components/HomeCta/HomeCtaButtons.jsx";
import HomeSkillsGrid from "../components/HomeSkills/HomeSkillsGrid.jsx";
import { WHATSAPP_URL } from "../lib/contactLinks";
---

<Layout>
  <main class="outer_container">
    <h1 class="main_heading">BIM Software<br /> Development and Consulting</h1>
    <p class="main_paragraph">
      I'm a Licensed
      <span>Architect</span> &
      <span>Software Developer</span>
      focusing on <span>Full-Stack</span>
      <span>AEC solutions</span>,
      <span>Cloud</span> applications,
      <span>AI integration</span>,
      <span>BIM</span> collaboration, and
      <span>Interdisciplinary Problem Solving</span>
    </p>

    <div class="action_buttons_container">
      <button class="action_button action_button_action_level_2">
        View Profile
      </button>
      <button class="action_button action_button_action_level_1">
        <a
          href={WHATSAPP_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="action_button_link"
        >
          Let's Talk
        </a>
      </button>
    </div>
  </main>
</Layout>

<style>
  .outer_container {

    position: fixed;
    bottom: 0px;
    background: var(--glassed_background);
    backdrop-filter: blur(10px);
    padding: 15px 20px 20px 20px;
    width: 100%;
  }

  .main_heading {
    font-size: 1.65rem;
    line-height: 1.8rem;
    margin-bottom: 20px;
    color: var(--site-body-fg);
    font-weight: 800;
  }

  .main_paragraph {
    margin: 0px 0 0px 0;
    color: var(--site-body-fg);
    font-weight: 600;
    line-height: 2rem;
    font-size: 1rem;
  }

  span {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    background: var(--site-body-bg);
    color: var(--site-body-fg);
    padding: 0px 5px;
    height: 25px;
    box-shadow: 3px 3px 3px rgba(0, 0, 0, 0.4);
  }

  .action_buttons_container {
    display: flex;
    gap: 10px;
    margin-top: 25px;
  }

  .action_button {
    cursor: pointer;
    width: 100%;
    height: var(--control_min_height);
    min-width: var(--control_min_width);
    display: flex;
    align-items: center;
    justify-content: center;
    border: none;
    padding: 2px 10px;
    font-family: inherit;
    font-size: 1rem;
    text-decoration: none;
    font-weight: 700;
    background: var(--site-body-fg);
    color: var(--site-body-bg);
  }

  .action_button_link {
    display: flex;
    align-items: center;
    text-decoration: none;
    color: inherit;
    font-family: inherit;
    height: 100%;
  }

  .action_button_action_level_1 {
  }

  .action_button_action_level_2 {
  }

  @media (min-width: 768px) {
  }

  @media (min-width: 1024px) {
    .outer_container {
      height: 100vh;
      position: relative;
      top: 140px;
      bottom: auto;
      margin: 0 auto;
      padding: 0 0 0 50px;
      width: 550px;
      background: none !important;
      /* box-shadow: 10px 10px 10px rgba(0, 0, 0, 0.2); */
    }

    .main_heading {
      margin-bottom: 40px;
      font-size: 2.5em;
      line-height: 2.3rem;
    }

    .action_buttons_container {
      gap: 10px;
      width: 300px;
      margin-top: 40px;
    }

    .action_button {
    }

    span {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      background: var(--site-body-bg);
      color: var(--site-body-fg);
      padding: 0px 0px;
      height: 25px;
      box-shadow: none;
    }
  }
</style>
