---
import Layout from "../layouts/Layout.astro";
import HomeCtaButtons from "../components/HomeCta/HomeCtaButtons.jsx";
import HomeSkillsGrid from "../components/HomeSkills/HomeSkillsGrid.jsx";
---

<Layout>
  <main class="outer_container">
    <h1 class="main_heading">BIM Software Development and Consulting</h1>
    <p class="main_paragraph">
      I'm an technologist, AI enthusiast, Licensed Architect, BIM Modeler, Professional Full Stack
      Software Developer, and AEC BIM Programmer with a multidisciplinary background spanning Design,
      Architecture, Art, Technology, Software Engineering, AI integrations and
      Cloud-Based Solutions.
    </p>

    <HomeCtaButtons client:load />

    <!-- <HomeSkillsGrid />

    <p class="home-main__outro" data-i18n="homeOutro">
      I feel comfortable working in interdisciplinary, intercultural,
      inter-generational and inclusive remote and on-site teams.
    </p> -->
  </main>
</Layout>

<style>
  .outer_container {
    top: 340px;
    background: rgba(255,255,255,.21);
    backdrop-filter: blur(10px);
    padding: 10px;
  }

  .main_heading{
    font-size: 1.5rem;
    line-height: 1.35rem;
  }

  .main_paragraph {
    margin: 15px 0 20px 0;
  }
