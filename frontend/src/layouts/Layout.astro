---
// Import your Tailwind CSS file
import "../styles/global.css";
import GlobalActivityBar from "../components/GlobalActivityBar.jsx";

interface Props {
  title?: string;
  showGlobalActivityBar?: boolean;
}

const { title = "Eduardo Osteicoechea", showGlobalActivityBar = true } =
  Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
      <meta charset="utf-8" />
      <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
      <link rel="icon" href="/favicon.ico" />
      <meta name="viewport" content="width=device-width" />
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link
        href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Raleway:ital,wght@0,100..900;1,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap"
        rel="stylesheet"
      />

      <meta
        name="description"
        content="Architecturally trained BIM Modeler & Full Stack Developer. Bridging design and technology with custom Automations, AI integrations, and cloud solutions."
      />
      <link rel="icon" href="/media/favicon.ico" sizes="any" />
      <link
        rel="icon"
        type="image/png"
        sizes="32x32"
        href="/media/favicon-32x32.png"
      />
      <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
      <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
      <link
        rel="icon"
        href="/favicon-192.png"
        sizes="192x192"
        type="image/png"
      />
      <link rel="apple-touch-icon" href="/favicon-180.png" sizes="180x180" />
      <link
        rel="shortcut icon"
        href="/favicon-32.png"
        sizes="32x32"
        type="image/png"
      />
      <meta
        name="google-site-verification"
        content="RQdklgFawBo75p5tN7wranunENDjUu27gol9MENm-SM"
      />

      <meta name="generator" content={Astro.generator} />
      <title>{title}</title>
      <script is:inline>
        try {
          if (localStorage.getItem("eduardoos-theme") === "dark") {
            document.documentElement.classList.add("dark");
          }
          var fontId = localStorage.getItem("eduardoos-font-family");
          var fontStacks = {
            montserrat: '"Montserrat", sans-serif',
            raleway: '"Raleway", sans-serif',
            roboto: '"Roboto", sans-serif',
            system:
              'system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
          };
          if (fontId && fontStacks[fontId]) {
            document.documentElement.style.setProperty(
              "--font-family",
              fontStacks[fontId],
            );
          }
          var fontSize = localStorage.getItem("eduardoos-article-font-size");
          if (fontSize) {
            document.documentElement.style.fontSize = fontSize + "px";
          }
        } catch (_) {}
      </script>
    </head>
    <body>
        
      <slot />

      {showGlobalActivityBar ? <GlobalActivityBar client:load /> : null}
      
    </body>
</html>
