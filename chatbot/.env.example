PORT=8110
BIND_HOST=127.0.0.1

# Required: only the Node backend may call this service (sent as X-Chatbot-Internal-Token).
CHATBOT_INTERNAL_TOKEN=change-me-internal-token
POSTS_DB_URL=http://127.0.0.1:8120
POSTS_DB_INTERNAL_TOKEN=change-me-internal-posts-db-token

# Public session auth via backend proxy (off until session API exists).
CHATBOT_PUBLIC_AUTH_ENABLED=false

# DeepSeek (OpenAI-compatible). Get key: https://platform.deepseek.com/api_keys
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=your-deepseek-api-key
# deepseek-chat = fast chat | deepseek-reasoner = thinking / slower
LLM_MODEL=deepseek-chat

# Response guidelines & static knowledge (paths relative to WorkingDirectory)
GUIDELINES_PATH=guidelines/RESPONSE_GUIDELINES.md
KNOWLEDGE_DIR=guidelines/knowledge
KNOWLEDGE_MAX_CHARS=28000
