POST_EDITOR_PASSWORD=<your-password>

# Chatbot Go service (localhost only in production)
CHATBOT_URL=http://127.0.0.1:8110
CHATBOT_INTERNAL_TOKEN=change-me-internal-token
# Set true when session API is ready (currently rejects without x-session-id)
CHATBOT_PUBLIC_AUTH_ENABLED=false

# Posts catalog SQLite service (localhost only — never expose publicly)
POSTS_DB_URL=http://127.0.0.1:8120
POSTS_DB_INTERNAL_TOKEN=change-me-internal-posts-db-token
