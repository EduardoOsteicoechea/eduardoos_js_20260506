POST_EDITOR_PASSWORD=<legacy-fallback-not-used-for-save>

# JWT auth (15m access, 7d refresh via HttpOnly cookie)
JWT_ACCESS_SECRET=<openssl rand -base64 48>
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_MS=604800000
AUTH_COOKIE_NAME=eduardoos_refresh
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
APP_PUBLIC_URL=http://localhost:4321

# Gmail app password for verification and reset emails
GOOGLE_EMAIL_APP_EMAIL=
GOOGLE_EMAIL_APP_PASSWORD=

# Chatbot Go service (localhost only in production)
CHATBOT_URL=http://127.0.0.1:8110
CHATBOT_INTERNAL_TOKEN=change-me-internal-token
CHATBOT_PUBLIC_AUTH_ENABLED=false

# Posts catalog service (localhost only — never expose publicly)
POSTS_DB_URL=http://127.0.0.1:8120
POSTS_DB_INTERNAL_TOKEN=change-me-internal-posts-db-token

# S3 media API (localhost only — never expose publicly)
S3_URL=http://127.0.0.1:8130
S3_INTERNAL_TOKEN=change-me-internal-s3-token
